# Generate a long random value and keep the real value only in vectors/.env.
# Example generator: openssl rand -hex 32
LOG_EXPORT_API_KEY=replace-with-a-long-random-secret

# Optional. Needed only when a browser on another origin calls the export API
# directly. Server-to-server requests do not use CORS.
LOG_EXPORT_CORS_ORIGINS=https://evaluation.example.edu

# Stopgap alternative to RAG retrieval: dumps the entire KB into the model's
# context instead of picking top-k chunks. Off by default; flip to true/1 and
# restart the backend to switch a deployment over, no rebuild needed. Does
# not replace the RAG path — flip back off to return to it.
FULL_KB_CONTEXT_MODE=false
FULL_KB_CONTEXT_MODEL=gpt-4.1

# Share of full-context answers re-checked by the verifier in the background,
# logging only (logs/audit/answer_audit.jsonl). Each audit re-sends the whole KB,
# so keep it low; 0 disables.
FULL_KB_AUDIT_SAMPLE_RATE=0.1
